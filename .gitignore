# -- dependencies & environments -------------------------------------------
.DS_Store
__pycache__/
*.pyc
node_modules/
.venv/
tools/bin/

# -- build output (fully regenerable) --------------------------------------
dist/

# -- original release archives: never in a public repo. Rehydrate with
#    `node tools/fetch/originals.mjs` from the prod.json manifests. ---------
originals/*
!originals/README.md

# -- per-production exclusions ---------------------------------------------
# Planet Potion's web/data/ is the export of the original's own output — the
# draw stream, the texture bytecode, the reference PNGs. Regenerate it with
# `./ppcbox.sh python3 export.py flat/ out/` in work/re, then copying out/
# across — the browser's rendercheck serves this directory, so an empty one
# shows up as 404s on draws.json rather than as a missing dataset. The full
# recipe is in checkall.sh. Derived from the binary, so it does not live here.
productions/planet-potion/web/data/
# The same rule one step upstream: `hunkload.py` writes the relocated segments
# as raw .bin, so flat/ IS the original's code, and export.py / rendertex.py
# write their derived trees beside it. checkall.sh already told readers flat/
# was ignored; until now it was not, and the pre-commit guard only knew the
# "MZ" header, which an Amiga hunk executable does not have.
productions/planet-potion/work/re/flat/
productions/planet-potion/work/re/out/
productions/planet-potion/work/re/tex/
# synthdump.py's two modules: 8.3 MB the softsynth builds from the binary, and
# each one is under the pre-commit hook's 10 MB limit on its own.
productions/planet-potion/work/re/mods/
# libdigibooster3, fetched and built by oracle.sh. Third-party BSD-2 source
# plus binaries; the script that reproduces it is what belongs in git.
productions/planet-potion/work/re/oracle/
# hunkload.py output for the dbplayer.library embedded in seg1 — relocated
# segments of somebody else's copyrighted 68K, with no header for the
# pre-commit guard to recognise. Rebuild it with
# `python3 hunkload.py flat/seg1_DATA_10010000.bin dbp/`.
productions/planet-potion/work/re/dbp/
# And the unpack target itself. Energia's unpacked/ holds extracted ASSETS and
# is committed file by file; planet-potion's holds nothing but the pristine
# release — two executables and the release .txt — so it goes out whole, as
# lapsus's does. Rehydrate: `node tools/fetch/originals.mjs planet-potion`
# then `bsdtar -xf originals/potion/potionplanet_potion.lha -C <here>`.
productions/planet-potion/work/unpacked/

# Ghidra project databases embed the analyzed original binary.
productions/*/work/ghidra/
productions/*/work/ghidra-project/
# The unzipped original releases (and tesla's released source tree): pristine
# copyrighted payload, rehydrated by unzipping the archives that
# tools/fetch/originals.mjs materializes. The unpack scripts and MANIFEST
# hashes that consume them ARE committed.
productions/*/work/src/
productions/tesla/work/source/
# Original executables (packed and depacked) — the unpack SCRIPTS are
# committed, their binary inputs/outputs are not. sonnet_img.bin is the one
# deliberate exception: the readable site ships it as runtime data already.
productions/*/work/unpacked/*.exe
productions/ptct/work/unpacked/party-extracted/frame_upx0_image.bin
productions/ptct/work/atg/atg2/atg.exe
productions/ptct/work/atg/atglib/example.exe
# Upstream iXalance release tarballs — belongs to the ixalance-js import phase.
productions/ptct/work/ixalance/
# Regenerable audio renders (baked soundtrack intermediates).
productions/ptct/work/webixs/*.wav
productions/lost-vegas/work/audio/*.wav
# The licensed RinneRadio track ships inside the original archive; until the
# energia site is published it stays out of the public repo.
productions/energia/web/assets/energia.mp3
# Lapsus assets are a straight unzip of the pinned original (unpack.mjs +
# MANIFEST.sha256 are committed); nothing ships publicly yet, so the
# copyrighted payload stays out until there is a publication decision.
productions/lapsus/work/unpacked/
# Reference captures are recorded, not distributed (see docs/…TODO §0).
# Rehydrate with `node tools/fetch/capture.mjs <slug>`.
productions/*/work/reference/
# Verify output is regenerable screenshot/report volume; the harness
# scripts that produce it are code and stay in.
productions/*/work/verify/*
!productions/*/work/verify/*.mjs
!productions/*/work/verify/*.sh
# Baked output is regenerable by the committed generators. Sonnet's two
# escape-hatch PNGs ship in dist, so they ride along.
productions/*/work/baked/*
!productions/sonnet/work/baked/tex
productions/sonnet/work/baked/tex/*
!productions/sonnet/work/baked/tex/11.png
!productions/sonnet/work/baked/tex_2x
productions/sonnet/work/baked/tex_2x/*
!productions/sonnet/work/baked/tex_2x/11.png

# -- local agent config (machine-specific absolute paths) -------------------
.claude/
.codex/
# Rendered comparison frames (regenerable via work/verify/frame.mjs).
productions/lapsus/work/verify/frames/

# inspector sweep output: run.json/issues.md are regenerable, frames are bulky
productions/*/work/verify/inspect/frames/
productions/*/work/verify/inspect/notes/
