# Dockerfile.ppcbox — the PowerPC oracle, in a box.
#
# ppcrun.py runs the intro's pure subsystems by hand-building a PPC ELF and
# executing it under `/usr/bin/qemu-ppc-static`. That is a Linux user-mode
# emulator, and user-mode emulation does not exist on macOS — Homebrew's qemu
# builds system targets only — so the whole oracle half of this directory
# (export.py, rendertex.py, runsynth.py, drawlog.py, texprobe.py …) is
# unrunnable on the machine most of this project is edited from.
#
# Everything needed is two apt packages, so the fix is a container rather than
# a second machine or a cloud session. Debian's qemu-user-static builds every
# target, ppc included, on an arm64 host as well as x86_64 — verified here as
# qemu-ppc 7.2.22 under Docker Desktop on Apple Silicon.
#
# python3-capstone is only for ppdis.py; nothing export.py touches imports it.
# The rest of the toolchain is standard library — even the PNG writer, which is
# hand-rolled on zlib, which is why there is no Pillow here.
FROM debian:bookworm-slim

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      qemu-user-static \
      python3 \
      python3-capstone \
 && rm -rf /var/lib/apt/lists/*

# ppcrun.py hardcodes /usr/bin/qemu-ppc-static; fail loudly at build time if a
# future base image moves it, rather than at the first oracle run.
RUN test -x /usr/bin/qemu-ppc-static

WORKDIR /work
